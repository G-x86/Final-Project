# ตัวอย่างไฟล์ .env — ก็อปเป็นชื่อ .env แล้วเติม key จริง
# ห้ามคอมมิตไฟล์ .env ขึ้น git (มีใน .gitignore แล้ว)
# วิธีใช้: ก็อปไฟล์นี้เป็น .env หรือรัน .\setup_keys.ps1 (แนะนำ)

# OpenRouter (โมเดลฟรีไม่เสียเงิน) — ขอ key ที่ https://openrouter.ai/
OPENROUTER_API_KEY=

# DeepSeek — ขอ key ที่ https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ชื่อโมเดลที่จะใช้ (ถ้าเว้นว่าง agent ใช้ค่า default ของ provider)
# openrouter ตัวอย่างฟรี: z-ai/glm-4.5:free | deepseek: deepseek-chat / deepseek-reasoner
LLM_MODEL=

# ขั้นสูง: เปลี่ยน endpoint เอง (เช่น Gemini/Qwen/Kimi ที่เข้ากันได้กับ OpenAI)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
